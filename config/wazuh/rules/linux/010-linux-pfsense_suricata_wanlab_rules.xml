<group name="pfsense,suricata,wan_lab,">

  <rule id="110200" level="0">
    <field name="suricata_sid" type="pcre2">^100020[1-5]$</field>
    <description>Base de classification des alertes WAN LAB pfSense Suricata</description>
  </rule>

  <rule id="110201" level="5">
    <if_sid>110200</if_sid>
    <field name="suricata_sid" type="pcre2">^1000201$</field>
    <description>pfSense Suricata : seuil ICMP depasse de $(srcip) vers $(dstip)</description>
    <group>icmp_activity,</group>
  </rule>

  <rule id="110202" level="6">
    <if_sid>110200</if_sid>
    <field name="suricata_sid" type="pcre2">^1000202$</field>
    <description>pfSense Suricata : SYN repetes vers SSH de $(srcip) vers $(dstip):$(dstport)</description>
    <group>ssh_activity,</group>
  </rule>

  <rule id="110203" level="6">
    <if_sid>110200</if_sid>
    <field name="suricata_sid" type="pcre2">^1000203$</field>
    <description>pfSense Suricata : SYN repetes vers RDP de $(srcip) vers $(dstip):$(dstport)</description>
    <group>rdp_activity,</group>
  </rule>

  <rule id="110204" level="6">
    <if_sid>110200</if_sid>
    <field name="suricata_sid" type="pcre2">^1000204$</field>
    <description>pfSense Suricata : SYN repetes vers SMB de $(srcip) vers $(dstip):$(dstport)</description>
    <group>smb_activity,</group>
  </rule>

  <rule id="110205" level="5">
    <if_sid>110200</if_sid>
    <field name="suricata_sid" type="pcre2">^1000205$</field>
    <description>pfSense Suricata : rafale SYN HTTP/HTTPS de $(srcip) vers $(dstip):$(dstport)</description>
    <group>web_activity,</group>
  </rule>

</group>