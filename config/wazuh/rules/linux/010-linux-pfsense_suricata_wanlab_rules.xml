<group name="pfsense,suricata,wan_lab,">

  <rule id="110200" level="11">
    <decoded_as>pfsense-suricata-wanlab</decoded_as>
    <description>pfSense Suricata : alerte recue par Syslog</description>
  </rule>

  <rule id="110201" level="11">
    <if_sid>110200</if_sid>
    <field name="suricata_sid" type="pcre2">^(1000201|1000206)$</field>
    <description>pfSense Suricata : activite ICMP WAN LAB</description>
    <group>icmp_activity,</group>
  </rule>

  <rule id="110202" level="11">
    <if_sid>110200</if_sid>
    <field name="suricata_sid" type="pcre2">^(1000202|2003068)$</field>
    <description>pfSense Suricata : detection de scan SSH - SID $(suricata_sid)</description>
    <group>ssh_activity,</group>
  </rule>

  <rule id="110203" level="11">
    <if_sid>110200</if_sid>
    <field name="suricata_sid" type="pcre2">^1000203$</field>
    <description>pfSense Suricata : SYN repetes vers RDP - SID 1000203</description>
    <group>rdp_activity,</group>
  </rule>

  <rule id="110204" level="11">
    <if_sid>110200</if_sid>
    <field name="suricata_sid" type="pcre2">^1000204$</field>
    <description>pfSense Suricata : SYN repetes vers SMB - SID 1000204</description>
    <group>smb_activity,</group>
  </rule>

  <rule id="110205" level="11">
    <if_sid>110200</if_sid>
    <field name="suricata_sid" type="pcre2">^1000205$</field>
    <description>pfSense Suricata : rafale SYN HTTP/HTTPS - SID 1000205</description>
    <group>web_activity,</group>
  </rule>

</group>