<decoder name="pfsense-suricata-wanlab">
  <prematch type="pcre2">\[\d+:\d+:\d+\].*\[Priority:\s*\d+\]\s+\{\w+\}</prematch>
  <regex type="pcre2">\[\d+:(\d+):\d+\]\s+(.*?)\s+(?:\[\*\*\]\s+)?(?:\[Classification:.*?\]\s+)?\[Priority:\s*(\d+)\]\s+\{(\w+)\}\s+([0-9.]+)(?::(\d+))?\s+->\s+([0-9.]+)(?::(\d+))?</regex>
  <order>suricata_sid,suricata_msg,suricata_priority,protocol,srcip,srcport,dstip,dstport</order>
</decoder>